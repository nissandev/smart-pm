# ─────────────────────────────────────────────────────────────
# Smart PM — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to version control.
# ─────────────────────────────────────────────────────────────

# ── MongoDB ────────────────────────────────────────────────
# Pick ONE of the two options below.
#
# Option A — MongoDB Atlas (cloud, recommended for quick start):
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Create a DB user, allow your IP, and copy the SRV connection string.
#   3. Paste it here, append the database name (`/smartpm`).
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smartpm?retryWrites=true&w=majority
MONGO_DB=smartpm

# Option B — Local MongoDB (run separately):
#   docker run -d --name mongo -p 27017:27017 \
#     -e MONGO_INITDB_ROOT_USERNAME=admin \
#     -e MONGO_INITDB_ROOT_PASSWORD=secret mongo:7
# Then use:
# MONGO_URI=mongodb://admin:secret@host.docker.internal:27017/smartpm?authSource=admin

# ── Backend / JWT ──────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development

# ── URLs ───────────────────────────────────────────────────
# FRONTEND_URL can be a SINGLE origin or a COMMA-SEPARATED LIST of origins
# that the backend will allow via CORS. Use the EXACT scheme + host (no
# trailing slash). Examples:
#   FRONTEND_URL=http://localhost:3000
#   FRONTEND_URL=https://web-smart-pm.com,https://smartpm.nexarift.com
#   FRONTEND_URL=*               # only for public demos — disables origin check
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=SmartPM
